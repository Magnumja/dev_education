# URL pública do site (metadata, canonical e sitemap).
# Deixe VAZIA: em desenvolvimento cai em http://localhost:3000 e, na Vercel, o
# domínio de produção é detectado sozinho. Preencha só com domínio próprio.
NEXT_PUBLIC_SITE_URL=

# ── Supabase ──────────────────────────────────────────────────
# Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API Keys → Publishable key  (sb_publishable_...)
# Equivale à antiga "anon key". Vai para o navegador: é a RLS que a protege.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API Keys → Secret keys  (sb_secret_...)
# Equivale à antiga "service_role". IGNORA a RLS — nunca use no navegador
# nem prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Providers de conteúdo ─────────────────────────────────────
# GitHub: opcional. Sem token são 60 requisições/hora; com um PAT
# fine-grained de leitura pública, 5.000/hora.
GITHUB_TOKEN=

# Protege /api/ingest. Gere um valor aleatório com:  openssl rand -hex 32
# Localmente use INGEST_SECRET. Na Vercel, defina CRON_SECRET com o mesmo
# formato: o Vercel Cron envia esse valor sozinho no cabeçalho Authorization,
# e sem ele o agendamento recebe 401.
INGEST_SECRET=
CRON_SECRET=

# Canais acompanhados pela ingestão agendada, separados por vírgula.
# Aceita @handle, URL do canal ou o ID que começa com UC.
#   YOUTUBE_CHANNELS=@rocketseat,@FilipeDeschamps,@Fireship
YOUTUBE_CHANNELS=

# YouTube Data API — NÃO é usada: os vídeos vêm pelo feed RSS público, que não
# tem chave nem cota. Reservada para busca por palavra-chave no futuro.
YOUTUBE_API_KEY=
